    {
      "event": "game:sanity_changed",
      "condition": {"delta":{"lte":-10}},
      "actions": [{"type":"collection.set","collectionId":"achievementStates","recordId":"san_fast_drop","value":{"unlocked":true,"statusMark":"✅","statusClass":"unlocked","unlockDate":{"variable":"gameState:day"}}}]
    },
    {
      "event": "daynight:changed",
      "condition": {"day":{"gte":5},"sanity":{"gte":80}},
      "actions": [{"type":"collection.set","collectionId":"achievementStates","recordId":"san_steady","value":{"unlocked":true,"statusMark":"✅","statusClass":"unlocked","unlockDate":{"variable":"gameState:day"}}}]
    },
    {
      "event": "game:sanity_changed",
      "condition": {"hadLow":true,"value":{"gte":60}},
      "actions": [{"type":"collection.set","collectionId":"achievementStates","recordId":"san_recovery","value":{"unlocked":true,"statusMark":"✅","statusClass":"unlocked","unlockDate":{"variable":"gameState:day"}}}]
    },
    {
      "event": "gamestate:changed",
      "condition": {"sanity":{"eq":0}},
      "actions": [{"type":"collection.set","collectionId":"achievementStates","recordId":"san_zero","value":{"unlocked":true,"statusMark":"✅","statusClass":"unlocked","unlockDate":{"variable":"gameState:day"}}}]
