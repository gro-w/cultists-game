    {
      "event": "game:study",
      "actions": [
        {
          "type": "collection.incrementField",
          "collectionId": "achievementStates",
          "recordId": "study_king",
          "field": "progress",
          "value": 1,
          "unlockAt": 3,
          "unlockValue": {"unlocked":true,"statusMark":"✅","statusClass":"unlocked","unlockDate":{"variable":"gameState:day"}}
        }
      ]
    },
    {
      "event": "game:tabletop_session",
      "actions": [
        {
          "type": "collection.incrementField",
          "collectionId": "achievementStates",
          "recordId": "tabletop_veteran",
          "field": "progress",
          "value": 1,
          "unlockAt": 3,
          "unlockValue": {"unlocked":true,"statusMark":"✅","statusClass":"unlocked","unlockDate":{"variable":"gameState:day"}}
        }
      ]
    },
    {
      "event": "favorability:changed",
      "condition": {"path":"delta","op":"gt","value":0},
      "actions": [{"type":"collection.incrementField","collectionId":"achievementStates","recordId":"fav_cumulative_up","field":"progress","value":{"path":"delta"},"unlockAt":50,"unlockValue":{"unlocked":true,"statusMark":"✅","statusClass":"unlocked","unlockDate":{"variable":"gameState:day"}}}]
    },
    {
      "event": "favorability:changed",
      "condition": {"path":"delta","op":"lt","value":0},
      "actions": [{"type":"collection.incrementField","collectionId":"achievementStates","recordId":"fav_cumulative_down","field":"progress","value":{"path":"delta"},"absolute":true,"unlockAt":30,"unlockValue":{"unlocked":true,"statusMark":"✅","statusClass":"unlocked","unlockDate":{"variable":"gameState:day"}}}]
    },
    {
      "event": "game:skill_check",
      "condition": {"path":"outcome","in":["success","criticalSuccess"]},
      "actions": [{"type":"collection.incrementField","collectionId":"achievementStates","recordId":"skillcheck_cumulative_success","field":"progress","value":1,"unlockAt":5,"unlockValue":{"unlocked":true,"statusMark":"✅","statusClass":"unlocked","unlockDate":{"variable":"gameState:day"}}}]
    },
    {
      "event": "game:study",
      "actions": [{"type":"collection.set","collectionId":"achievementStates","recordId":"study_first","value":{"unlocked":true,"statusMark":"✅","statusClass":"unlocked","unlockDate":{"variable":"gameState:day"}}}]
    },
    {
      "event": "game:study_night",
      "actions": [{"type":"collection.set","collectionId":"achievementStates","recordId":"study_believer","value":{"unlocked":true,"statusMark":"✅","statusClass":"unlocked","unlockDate":{"variable":"gameState:day"}}}]
    },
    {
      "event": "game:tabletop_session",
      "actions": [{"type":"collection.set","collectionId":"achievementStates","recordId":"tabletop_first","value":{"unlocked":true,"statusMark":"✅","statusClass":"unlocked","unlockDate":{"variable":"gameState:day"}}}]
    },
    {
      "event": "game:tabletop_skipped",
      "actions": [{"type":"collection.set","collectionId":"achievementStates","recordId":"tabletop_skip","value":{"unlocked":true,"statusMark":"✅","statusClass":"unlocked","unlockDate":{"variable":"gameState:day"}}}]
    },
    {
      "event": "game:skill_check",
      "condition": {"path":"outcome","in":["success","criticalSuccess"]},
      "actions": [{"type":"collection.set","collectionId":"achievementStates","recordId":"skillcheck_first_success","value":{"unlocked":true,"statusMark":"✅","statusClass":"unlocked","unlockDate":{"variable":"gameState:day"}}}]
    },
    {
      "event": "game:skill_check",
      "condition": {"path":"outcome","in":["failure","criticalFailure"]},
      "actions": [{"type":"collection.set","collectionId":"achievementStates","recordId":"skillcheck_first_failure","value":{"unlocked":true,"statusMark":"✅","statusClass":"unlocked","unlockDate":{"variable":"gameState:day"}}}]
    },
    {
      "event": "game:exam_result",
      "condition": {"path":"score","op":"gte","value":60},
      "actions": [{"type":"collection.set","collectionId":"achievementStates","recordId":"exam_pass","value":{"unlocked":true,"statusMark":"✅","statusClass":"unlocked","unlockDate":{"variable":"gameState:day"}}}]
    },
    {
      "event": "favorability:changed",
      "condition": {"value":{"gte":100}},
      "actions": [{"type":"collection.set","collectionId":"achievementStates","recordId":"fav_maxed","value":{"unlocked":true,"statusMark":"✅","statusClass":"unlocked","unlockDate":{"variable":"gameState:day"}}}]
    },
    {
      "event": "favorability:changed",
      "condition": {"value":{"eq":0}},
      "actions": [{"type":"collection.set","collectionId":"achievementStates","recordId":"fav_zeroed","value":{"unlocked":true,"statusMark":"✅","statusClass":"unlocked","unlockDate":{"variable":"gameState:day"}}}]
    },
    {
      "event": "favorability:changed",
      "condition": {"allAbove":75},
      "actions": [{"type":"collection.set","collectionId":"achievementStates","recordId":"fav_three_high","value":{"unlocked":true,"statusMark":"✅","statusClass":"unlocked","unlockDate":{"variable":"gameState:day"}}}]
    },
    {
      "event": "favorability:changed",
      "condition": {"allHadPositive":true},
      "actions": [{"type":"collection.set","collectionId":"achievementStates","recordId":"fav_all_positive","value":{"unlocked":true,"statusMark":"✅","statusClass":"unlocked","unlockDate":{"variable":"gameState:day"}}}]
    },
    {
      "event": "ending__triggered",
