        {
          "type": "variable.set",
          "key": "turtleSoup:message",
          "value": {
            "path": "questionText"
          }
        },
        {
          "type": "collection.append",
          "collectionId": "eventHistory",
          "value": {
            "kind": "turtle-soup-question",
