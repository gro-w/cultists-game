{
  "version": 1,
  "defaultProgramIcon": "⚙️",
  "programs": [
    { "id": "his", "title": "HIS 医疗系统", "icon": "🏥", "kind": "window", "target": "his" },
    { "id": "chatgtp", "title": "ChatGTP", "icon": "🤖", "kind": "window", "target": "chatgtp" },
    { "id": "dialogue", "title": "夜聊 Messenger", "icon": "💬", "kind": "window", "target": "dialogue" },
    { "id": "notebook", "title": "笔记本", "icon": "📓", "kind": "window", "target": "notebook" },
    { "id": "status", "title": "状态与属性", "icon": "📊", "kind": "window", "target": "status" },
    { "id": "achievements", "title": "成就", "icon": "🏆", "kind": "window", "target": "achievements" },
    { "id": "calendar", "title": "日历", "icon": "📅", "kind": "window", "target": "calendar" },
    { "id": "locations", "title": "去往位置", "icon": "🗺️", "kind": "window", "target": "locations" },
    { "id": "social-media", "title": "社交媒体", "icon": "📱", "kind": "window", "target": "social-media" },
    { "id": "turtle-soup", "title": "海龟汤", "icon": "🐢", "kind": "window", "target": "turtle-soup" },
    { "id": "off-duty-open", "title": "下班", "icon": "🌙", "kind": "activity", "target": "off-duty-open" },
    { "id": "settings", "title": "设置", "icon": "⚙️", "kind": "window", "target": "settings" },
    { "id": "file-manager", "title": "文件管理器", "icon": "🗂️", "kind": "window", "target": "file-manager" },
    { "id": "document", "title": "文档", "icon": "📝", "kind": "window", "target": "document" },
    { "id": "terminal", "title": "终端", "icon": "⌨️", "kind": "window", "target": "terminal" }
  ],
  "hisCustom": {
    "version": 2,
    "id": "his_custom",
    "title": "HIS 医疗系统",
    "icon": "🏥",
    "width": 640,
    "height": 460,
    "background": "#d4d0c8",
    "layout": "his",
    "widgets": [
      {
        "id": "patient-list",
        "type": "list",
        "x": 0,
        "y": 0,
        "width": 140,
        "height": 460,
        "text": "候诊病人",
        "cssClass": "his-patient-list panel-inset",
        "onSelect": "his-select-patient"
      },
      {
        "id": "medical-incidents",
        "type": "panel",
        "x": 0,
        "y": 0,
        "width": 488,
        "height": 28,
        "text": "",
        "cssClass": "his-medical-incidents"
      },
      {
        "id": "dialogue",
        "type": "panel",
        "x": 0,
        "y": 0,
        "width": 488,
        "height": 190,
        "text": "请先选择左侧病人",
        "cssClass": "his-dialogue panel-inset"
      },
      {
        "id": "diagnosis-panel",
        "type": "panel",
        "x": 0,
        "y": 0,
        "width": 488,
        "height": 82,
        "text": "诊断",
        "cssClass": "his-diagnosis panel-inset"
      },
      {
        "id": "diagnosis-category",
        "type": "select",
        "x": 0,
        "y": 0,
        "width": 210,
        "height": 30,
        "text": "诊断分类",
        "cssClass": "diagnosis-category",
        "onChange": "his-filter-diagnosis"
      },
      {
        "id": "diagnosis",
        "type": "select",
        "x": 0,
        "y": 0,
        "width": 218,
        "height": 30,
        "text": "诊断",
        "cssClass": "diagnosis-select"
      },
      {
        "id": "prescription",
        "type": "panel",
        "x": 0,
        "y": 0,
        "width": 488,
        "height": 136,
        "text": "处方",
        "cssClass": "his-prescription panel-inset"
      },
      {
        "id": "medicine-1",
        "type": "select",
        "x": 0,
        "y": 0,
        "width": 250,
        "height": 24,
        "text": "药品"
      },
      {
        "id": "submit",
        "type": "button",
        "x": 0,
        "y": 0,
        "width": 178,
        "height": 34,
        "text": "提交诊断与处方",
        "onClick": "his-submit"
      }
    ],
    "onCreate": "his-initialize",
    "activityIds": {
      "his-initialize": "his:his-initialize",
      "his-search": "his:his-search",
      "his-select-patient": "his:his-select-patient",
      "his-filter-diagnosis": "his:his-filter-diagnosis",
      "his-submit": "his:his-submit"
    }
  },
  "desktopApps": [
    {
      "id": "his_custom",
      "title": "自定义 HIS 原型",
      "icon": "🏥",
      "file": "app_his_custom.json"
    }
  ]
}
